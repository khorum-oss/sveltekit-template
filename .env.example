# Drizzle / SQLite
DATABASE_URL=local.db

# Backend API URL (server-side proxy target)
BACKEND_URL=http://localhost:8080

# Environment: development | staging | production
PUBLIC_APP_ENV=development

# Auth: enable/disable login requirement
PUBLIC_AUTH_ENABLED=true

# Default data source: mocked | local-storage | api | local-db
PUBLIC_DEFAULT_DATA_SOURCE=mocked

# CORS: allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# JWT secret for server-side token validation (required in production)
# JWT_SECRET=
